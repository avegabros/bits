# Cloud server WebSocket URL (wss:// for production, ws:// for local dev)
BITS_CLOUD_URL=ws://localhost:3001

# Unique agent token — provided by BITS admin when registering the branch agent
AGENT_TOKEN=agent_token_here

# Comma-separated list of local ZKTeco device IPs and ports
# Format: ip:port,ip:port
DEVICES=192.168.1.201:4370

# Optional: Agent label for identification
AGENT_LABEL=Branch Office Agent
