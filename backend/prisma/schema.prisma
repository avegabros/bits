generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Attendance {
  id                   Int                    @id @default(autoincrement())
  employeeId           Int
  date                 DateTime
  shiftId              Int?
  checkInTime          DateTime
  checkOutTime         DateTime?
  checkin_updated      DateTime?
  checkout_updated     DateTime?
  status               String                 @default("present")
  notes                String?
  checkInDeviceId      Int?
  checkOutDeviceId     Int?
  checkInAuthMethod    String?
  checkOutAuthMethod   String?
  checkoutSource       String?
  lateMinutes          Int                    @default(0)
  undertimeMinutes     Int                    @default(0)
  overtimeMinutes      Float                  @default(0.0)
  totalHours           Float                  @default(0.0)
  isAnomaly            Boolean                @default(false)
  isEarlyOut           Boolean                @default(false)
  gracePeriodApplied   Boolean                @default(false)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  checkInDevice        Device?                @relation("AttCheckIn", fields: [checkInDeviceId], references: [id])
  checkOutDevice       Device?                @relation("AttCheckOut", fields: [checkOutDeviceId], references: [id])
  employee             Employee               @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shift                Shift?                 @relation("AttendanceShift", fields: [shiftId], references: [id])
  AttendanceAdjustment AttendanceAdjustment[]

  @@unique([employeeId, date, shiftId])
  @@index([date])
  @@index([employeeId])
  @@index([status])
  @@index([shiftId])
}

model AttendanceAdjustment {
  id            Int @id @default(autoincrement())
  attendanceId  Int?
  submittedById Int

  type String @default("UPDATE") // UPDATE, DELETE

  // Snapshot of original values at time of request
  originalCheckIn  DateTime?
  originalCheckOut DateTime?

  // Requested new values
  requestedCheckIn  DateTime?
  requestedCheckOut DateTime?

  // Snapshot of employee info (survives attendance deletion)
  employeeName   String?
  employeeBranch String?

  reason String // Required — why the adjustment is needed

  // Approval workflow
  status          String  @default("pending") // pending, approved, rejected
  reviewedById    Int?
  rejectionReason String?

  submittedAt DateTime  @default(now())
  reviewedAt  DateTime?

  // Relations
  attendance  Attendance? @relation(fields: [attendanceId], references: [id], onDelete: SetNull)
  submittedBy Employee   @relation("AdjustmentSubmittedBy", fields: [submittedById], references: [id])
  reviewedBy  Employee?  @relation("AdjustmentReviewedBy", fields: [reviewedById], references: [id])

  @@index([attendanceId])
  @@index([submittedById])
  @@index([status])
  @@index([submittedAt])
}

model AttendanceLog {
  id          Int       @id @default(autoincrement())
  timestamp   DateTime
  status      Int
  employeeId  Int
  deviceId    Int?
  authMethod  String?
  createdAt   DateTime  @default(now())
  processedAt DateTime?
  Device      Device?   @relation(fields: [deviceId], references: [id])
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([timestamp, employeeId])
  @@index([deviceId])
  @@index([employeeId])
  @@index([timestamp])
  @@index([processedAt])
}

model Department {
  id                Int                 @id @default(autoincrement())
  name              String              @unique
  createdAt         DateTime            @default(now())
  updatedAt         DateTime
  Employee          Employee[]
  ManagerDepartment ManagerDepartment[]
  sections          SectionDepartment[]
}

model Section {
  id           Int                 @id @default(autoincrement())
  name         String              @unique
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  Employee     Employee[]
  departments  SectionDepartment[]
}

model SectionDepartment {
  sectionId    Int
  departmentId Int
  assignedAt   DateTime   @default(now())

  section      Section    @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@id([sectionId, departmentId])
  @@index([sectionId])
  @@index([departmentId])
}

model ManagerDepartment {
  id           Int        @id @default(autoincrement())
  managerId    Int
  departmentId Int
  assignedAt   DateTime   @default(now())
  assignedById Int?

  manager      Employee   @relation("ManagerDepartments", fields: [managerId], references: [id], onDelete: Cascade)
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  assignedBy   Employee?  @relation("ManagerDeptAssignedBy", fields: [assignedById], references: [id])

  @@unique([managerId, departmentId])
  @@index([managerId])
  @@index([departmentId])
}

model Company {
  id        Int             @id @default(autoincrement())
  name      String          @unique
  logo      String?
  address   String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  branches  CompanyBranch[]
  employees Employee[]
}

model Branch {
  id        Int             @id @default(autoincrement())
  name      String          @unique
  createdAt DateTime        @default(now())
  updatedAt DateTime
  Employee  Employee[]
  companies CompanyBranch[]
  holidays  HolidayBranch[]
}

model CompanyBranch {
  companyId Int
  branchId  Int
  company   Company @relation(fields: [companyId], references: [id])
  branch    Branch  @relation(fields: [branchId], references: [id])

  @@id([companyId, branchId])
}

model Device {
  id                            Int                             @id @default(autoincrement())
  name                          String                          @unique
  ip                            String                          @unique
  port                          Int                             @default(4370)
  location                      String?
  isActive                      Boolean                         @default(true)
  syncEnabled                   Boolean                         @default(true)
  lastSyncedAt                  DateTime?
  lastSyncStatus                String?
  lastSyncError                 String?
  lastPolledAt                  DateTime?
  lastReconciledAt              DateTime?
  createdAt                     DateTime                        @default(now())
  updatedAt                     DateTime
  AttendanceCheckIns            Attendance[]                    @relation("AttCheckIn")
  AttendanceCheckOuts           Attendance[]                    @relation("AttCheckOut")
  AttendanceLog                 AttendanceLog[]
  DeviceSyncTasks               DeviceSyncTask[]
  EmployeeCardEnrollment        EmployeeCardEnrollment[]
  EmployeeDeviceEnrollment      EmployeeDeviceEnrollment[]
  EmployeeFingerprintEnrollment EmployeeFingerprintEnrollment[]
  DeviceBiometricExclusion      DeviceBiometricExclusion[]

  @@index([isActive])
  @@index([syncEnabled])
}

model Employee {
  id                  Int              @id @default(autoincrement())
  zkId                Int?             @unique
  cardNumber          Int?             @unique // RFID badge card number (uint32 from device offset 35)
  firstName           String
  lastName            String
  middleName          String?
  suffix              String?
  gender              String?
  dateOfBirth         DateTime?
  role                Role             @default(USER)
  email               String?          @unique
  password            String?
  needsPasswordChange Boolean          @default(false)
  employmentStatus    EmploymentStatus @default(ACTIVE)
  profilePicture      String?          // Relative URL: "/api/uploads/avatars/{id}.webp"

  // Secondary Info
  position       String?
  contactNumber  String?          @unique
  employeeNumber String?   @unique
  hireDate       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime

  // Relations
  departmentId                  Int?
  branchId                      Int?
  companyId                     Int?
  shiftId                       Int?
  sectionId                     Int?
  Attendance                    Attendance[]
  AdjustmentsReviewed           AttendanceAdjustment[]          @relation("AdjustmentReviewedBy")
  AdjustmentsSubmitted          AttendanceAdjustment[]          @relation("AdjustmentSubmittedBy")
  OvertimeReviewed              OvertimeRequest[]               @relation("OvertimeReviewedBy")
  OvertimeSubmitted             OvertimeRequest[]               @relation("OvertimeSubmittedBy")
  AttendanceLog                 AttendanceLog[]
  AuditLogs                     AuditLog[]
  Branch                        Branch?                         @relation(fields: [branchId], references: [id])
  Company                       Company?                        @relation(fields: [companyId], references: [id])
  Department                    Department?                     @relation(fields: [departmentId], references: [id])
  Section                       Section?                        @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  ManagerDepartments            ManagerDepartment[]             @relation("ManagerDepartments")
  ManagerDeptAssignments        ManagerDepartment[]             @relation("ManagerDeptAssignedBy")
  Shift                         Shift?                          @relation(fields: [shiftId], references: [id])
  EmployeeShift                 EmployeeShift[]
  EmployeeCardEnrollment        EmployeeCardEnrollment[]
  EmployeeDeviceEnrollment      EmployeeDeviceEnrollment[]
  EmployeeFingerprintEnrollment EmployeeFingerprintEnrollment[]
  DeviceBiometricExclusion      DeviceBiometricExclusion[]
  RefreshToken                  RefreshToken[]

  @@index([departmentId])
  @@index([sectionId])
  @@index([branchId])
  @@index([companyId])
  @@index([shiftId])
  @@index([email])
  @@index([employeeNumber])
  @@index([employmentStatus])
  @@index([role])
}

model Shift {
  id           Int        @id @default(autoincrement())
  shiftCode    String     @unique @db.VarChar(7)
  name         String     @unique @db.VarChar(32)
  startTime    String
  endTime      String
  graceMinutes Int        @default(0)
  breakMinutes Int        @default(60)
  isNightShift Boolean    @default(false)
  isActive     Boolean    @default(true)
  description  String?
  workDays     String     @default("[\"Mon\",\"Tue\",\"Wed\",\"Thu\",\"Fri\"]")
  halfDays     String     @default("[]")
  halfDayHours Float?
  breaks       String     @default("[]")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  Employee     Employee[]
  EmployeeShift EmployeeShift[]
  Attendance    Attendance[]    @relation("AttendanceShift")

  @@index([isActive])
}

model EmployeeShift {
  id         Int      @id @default(autoincrement())
  employeeId Int
  shiftId    Int
  sortOrder  Int      @default(0)
  isPrimary  Boolean  @default(false)
  assignedAt DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shift    Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@unique([employeeId, shiftId])
  @@index([employeeId])
  @@index([shiftId])
}

model RefreshToken {
  id         Int      @id @default(autoincrement())
  token      String   @unique
  employeeId Int
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([token])
  @@index([expiresAt])
}

model DeviceBiometricExclusion {
  id         Int      @id @default(autoincrement())
  employeeId Int
  deviceId   Int
  type       String   // 'FINGERPRINT' | 'CARD'
  excludedAt DateTime @default(now())
  excludedBy Int?
  reason     String?

  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  device     Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([employeeId, deviceId, type])
  @@index([employeeId])
  @@index([deviceId])
  @@index([type])
}

model EmployeeDeviceEnrollment {
  id         Int      @id @default(autoincrement())
  employeeId Int
  deviceId   Int
  enrolledAt DateTime @default(now())
  device     Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, deviceId])
  @@index([employeeId])
  @@index([deviceId])
}

model EmployeeFingerprintEnrollment {
  id          Int      @id @default(autoincrement())
  employeeId  Int
  deviceId    Int
  fingerIndex Int
  fingerLabel String
  enrolledAt  DateTime @default(now())
  device      Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, deviceId, fingerIndex])
  @@index([employeeId])
  @@index([deviceId])
}

model EmployeeCardEnrollment {
  id         Int      @id @default(autoincrement())
  employeeId Int
  deviceId   Int
  enrolledAt DateTime @default(now())
  device     Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, deviceId])
  @@index([employeeId])
  @@index([deviceId])
}

model AuditLog {
  id            Int       @id @default(autoincrement())
  timestamp     DateTime  @default(now())
  level         String    @default("INFO")
  action        String
  entityType    String
  entityId      Int?
  performedBy   Int?
  source        String    @default("system")
  details       String?
  metadata      Json?
  category      String    @default("system")
  correlationId String?
  performer     Employee? @relation(fields: [performedBy], references: [id])

  @@index([timestamp])
  @@index([action])
  @@index([entityType])
  @@index([performedBy])
  @@index([level])
  @@index([category])
  @@index([correlationId])
}

model Holiday {
  id          Int             @id @default(autoincrement())
  name        String
  date        DateTime        @unique
  description String?
  type        HolidayType     @default(REGULAR)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  branches    HolidayBranch[]

  @@index([date])
}

model HolidayBranch {
  holidayId Int
  branchId  Int
  holiday   Holiday @relation(fields: [holidayId], references: [id], onDelete: Cascade)
  branch    Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([holidayId, branchId])
  @@index([branchId])
}

model SyncConfig {
  id                           Int      @id @default(1)
  globalSyncEnabled            Boolean  @default(true)
  defaultIntervalSec           Int      @default(30)
  highFreqIntervalSec          Int      @default(30)
  lowFreqIntervalSec           Int      @default(600)
  shiftAwareSyncEnabled        Boolean  @default(false)
  shiftBufferMinutes           Int      @default(120)
  nightShiftBufferMinutes      Int      @default(120)
  autoTimeSyncEnabled          Boolean  @default(true)
  timeSyncIntervalSec          Int      @default(3600)
  globalMinCheckoutMinutes     Int      @default(120)
  minShiftGapMinutes           Int      @default(30)
  healthCheckEnabled           Boolean  @default(true)
  healthCheckIntervalSec       Int      @default(60)
  logBufferMaintenanceEnabled  Boolean  @default(true)
  logBufferMaintenanceSchedule String   @default("weekly")
  logBufferMaintenanceHour     Int      @default(3)
  updatedAt                    DateTime @updatedAt
}

model DeviceSyncTask {
  id         Int      @id @default(autoincrement())
  deviceId   Int
  actionType String
  entityId   String
  payload    Json
  status     String   @default("PENDING")
  retryCount Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  device     Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, actionType, entityId])
  @@index([deviceId, status])
  @@index([createdAt])
}

enum EmploymentStatus {
  ACTIVE
  STAGED
  INACTIVE
  TERMINATED
}

enum Role {
  USER
  HR
  MANAGER
  ADMIN
}

enum HolidayType {
  REGULAR
  SPECIAL
}

model OvertimeRequest {
  id              Int       @id @default(autoincrement())
  employeeId      Int
  date            DateTime
  startTime       String
  endTime         String
  reason          String
  status          String    @default("PENDING") // PENDING, APPROVED, REJECTED
  source          String    @default("REQUESTED") // REQUESTED, ASSIGNED
  reviewedById    Int?
  rejectionReason String?
  actualStartTime DateTime?
  actualEndTime   DateTime?
  submittedAt     DateTime  @default(now())
  reviewedAt      DateTime?

  employee        Employee  @relation("OvertimeSubmittedBy", fields: [employeeId], references: [id], onDelete: Cascade)
  reviewedBy      Employee? @relation("OvertimeReviewedBy", fields: [reviewedById], references: [id])

  @@index([employeeId])
  @@index([date])
  @@index([status])
}
