# Shared Environment Variables Template
# Copy this file to .env and fill in your own values.
# ⚠️ NEVER commit the actual .env file.

# ── General Server Settings ─────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ── Frontend Settings ────────────────────────────────────────────────
# LOCAL: URL of your backend server
# DOCKER: set in docker-compose.yml instead
BACKEND_URL=http://localhost:3001

# ── CORS Settings ───────────────────────────────────────────────────
# For Local running (No Docker): http://localhost:3000
# For Docker running: http://localhost:3013 (matching mapped host port)
FRONTEND_URL=http://localhost:3000

# ── Database Settings (LOCAL setup) ──────────────────────────────────
# For local dev, point to your local PostgreSQL instance.
# Docker users: DB_HOST is usually overridden by postgres container name
DB_HOST=localhost
DB_PORT=5432
DB_NAME=db_bits
DB_USER=postgres
DB_PASSWORD=root
DATABASE_URL=postgresql://postgres:root@localhost:5432/db_bits

# ── JWT Secrets ────────────────────────────────────────────────────
# Generated with: node -e "require('crypto').randomBytes(64).toString('hex')"
JWT_SECRET=REPLACE_WITH_64_BYTE_HEX_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_64_BYTE_HEX_SECRET

# ── ZKTeco Device ──────────────────────────────────────────────────
ZK_HOST=192.168.1.201
ZK_PORT=4370

# ── SMTP Settings (Email credentials notification) ──────────────────
# Use a Google App Password for Gmail, not your normal account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_app_password
