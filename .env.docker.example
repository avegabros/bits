# ==============================================================================
# 📟 BITS — Environment Variables Template (DOCKER Setup)
# ==============================================================================
# Use this template if you are running the services via Docker Compose.
# Copy this to ".env" in the root directory.

# ── General Settings ─────────────────────────────────────────────────
NODE_ENV=development

# ── Frontend Settings ────────────────────────────────────────────────
# Set to the Docker internal hostname of the backend container
BACKEND_URL=http://backend:3001

# ── CORS Settings ───────────────────────────────────────────────────
# FRONTEND_URL is what the browser uses to access the app (used for CORS mapping).
# LOCAL dev machine: http://localhost:3013
# LAN access via server IP: http://192.168.1.50:3013
FRONTEND_URL=http://localhost:3013

# ── Database Settings (Docker Postgres container) ─────────────────────
# DB_HOST points to the database service defined in docker-compose.yml
DB_HOST=postgres
DB_PORT=5432
DB_NAME=db_bits
DB_USER=root
DB_PASSWORD=root
DATABASE_URL=postgresql://root:root@postgres:5432/db_bits

# ── JWT Secrets ────────────────────────────────────────────────────
# Replace with a strong 64-byte hex secret (e.g., node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=REPLACE_WITH_64_BYTE_HEX_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_64_BYTE_HEX_SECRET

# ── ZKTeco Device ──────────────────────────────────────────────────
ZK_HOST=192.168.0.201
ZK_PORT=4370

# ── SMTP Settings (Email credentials notification) ──────────────────
# Use a Google App Password for Gmail, not your normal account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_app_password
