# ==============================================================================
# 📟 BITS — Environment Variables Template (LOCAL Setup - Non-Docker)
# ==============================================================================
# Use this template if you are running the frontend and backend directly on your 
# local machine (e.g. npm run dev). Copy this to ".env" in the root directory.

# ── General Server Settings ─────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ── Frontend Settings ────────────────────────────────────────────────
# Next.js will use this to call the backend locally
BACKEND_URL=http://localhost:3001

# ── CORS Settings ───────────────────────────────────────────────────
# URL where your frontend is running locally (used for CORS mapping)
FRONTEND_URL=http://localhost:3000

# ── Database Settings (Local PostgreSQL) ──────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=db_bits
DB_USER=postgres
DB_PASSWORD=root
DATABASE_URL=postgresql://postgres:root@127.0.0.1:5432/db_bits

# ── JWT Secrets ────────────────────────────────────────────────────
# Replace with a strong 64-byte hex secret (e.g., node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=REPLACE_WITH_64_BYTE_HEX_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_64_BYTE_HEX_SECRET

# ── ZKTeco Device ──────────────────────────────────────────────────
ZK_HOST=192.168.0.201
ZK_PORT=4370

# ── SMTP Settings (Email credentials notification) ──────────────────
# Use a Google App Password for Gmail, not your normal account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_app_password
# (Optional) Direct URL sent in system emails for logging in. Falls back to FRONTEND_URL if not provided.
SMTP_PORTAL_URL=https://bits.abas.ph

